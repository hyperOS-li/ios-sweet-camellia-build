+/*
+ * Read the file back and compare it byte for byte with the embedded blob.
+ * Returns 0 only when every byte matches: this is the kernel-side proof that
+ * the installer put the userland binary into the root filesystem intact.
+ */
+static int
+sweet_install_verify(const char *path, const void *data, size_t len)
+{
+	struct nameidata nd;
+	struct vnode_attr va;
+	vfs_context_t ctx = vfs_context_current();
+	int flags = FREAD;
+	int resid = 0, error = 0;
+	size_t off = 0;
+	unsigned char buf[256];
+
+	bzero(&nd, sizeof(nd));
+	VATTR_INIT(&va);
+	NDINIT(&nd, LOOKUP, OP_OPEN, FOLLOW, UIO_SYSSPACE,
+	    (user_addr_t)(uintptr_t)path, ctx);
+	error = vn_open_auth(&nd, &flags, &va, NULLVP);
+	if (error != 0) {
+		printf("SWEET INSTALL: verify open(%s) failed %d\n", path, error);
+		return error;
+	}
+	while (off < len) {
+		size_t chunk = sizeof(buf);
+
+		if (chunk > len - off) {
+			chunk = len - off;
+		}
+		resid = 0;
+		error = vn_rdwr(UIO_READ, nd.ni_vp, (caddr_t)buf, (int)chunk,
+		    (off_t)off, UIO_SYSSPACE, 0, vfs_context_ucred(ctx),
+		    &resid, vfs_context_proc(ctx));
+		if (error != 0 || resid != 0) {
+			error = error ? error : EIO;
+			break;
+		}
+		if (memcmp(buf, (const unsigned char *)data + off, chunk) != 0) {
+			error = EINVAL;
+			break;
+		}
+		off += chunk;
+	}
+	(void)vn_close(nd.ni_vp, flags, ctx);
+	return error;
+}
