+/* Same as nvt_read but assumes the event page is already latched. */
+static void
+nvt_read_latched(uint32_t addr, uint8_t *buf, int len)
+{
+	spi_cs(true);
+	spi_xfer(addr & 0x7Fu);
+	spi_xfer(0x00);
+	for (int i = 0; i < len; i++) {
+		buf[i] = spi_xfer(0x00);
+	}
+	spi_cs(false);
+}
