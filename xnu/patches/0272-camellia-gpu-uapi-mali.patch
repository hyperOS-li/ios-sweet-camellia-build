+		for (i = 0; i < SWEET_UAPI_SYNC_MAX; i++) {
+			if (!mali_uapi_syncs[i].used) {
+				mali_uapi_syncs[i].used = 1;
+				mali_uapi_syncs[i].signalled = (arg.flags & MALI_UAPI_SYNCOBJ_CREATE_SIGNALED) != 0;
+				mali_uapi_sync_count++;
