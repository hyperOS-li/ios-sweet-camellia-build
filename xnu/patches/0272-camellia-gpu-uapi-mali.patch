+		return SWEET_UAPI_ERR_OK;
+	}
+	case MALI_UAPI_SEL_JM_CTX_CREATE: {
+		struct mali_uapi_jm_ctx arg;
+
+		bcopy(in, &arg, sizeof(arg));
+		arg.handle = 1;                      /* one context per connection, viva style */
