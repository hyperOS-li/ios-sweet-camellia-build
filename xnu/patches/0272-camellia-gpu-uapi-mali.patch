+				return SWEET_UAPI_ERR_BADARG;
+			}
+			for (i = 0; i < arg.in_sync_count; i++) {
+				if (!mali_uapi_sync_alive(in_syncs[i])) {
+					return SWEET_UAPI_ERR_BADARG;
+				}
+			}
+		}
