+		struct mali_uapi_wait_bo arg;
+		struct mali_uapi_bo *bo;
+
+		bcopy(in, &arg, sizeof(arg));
+		bo = mali_uapi_bo_by_handle(arg.handle);
+		if (bo == NULL) {
+			return SWEET_UAPI_ERR_BADARG;
+		}
