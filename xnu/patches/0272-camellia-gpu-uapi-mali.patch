+		struct mali_uapi_sync_bo arg;
+		struct mali_uapi_bo_sync_op ops[SWEET_UAPI_HANDLES_MAX];
+		uint32_t i;
+
+		bcopy(in, &arg, sizeof(arg));
+		if (arg.op_count == 0 || arg.op_count > SWEET_UAPI_HANDLES_MAX || arg.ops == 0) {
+			return SWEET_UAPI_ERR_BADARG;
+		}
+		if (copyin((user_addr_t)arg.ops, ops,
+		    (vm_size_t)arg.op_count * sizeof(struct mali_uapi_bo_sync_op)) != 0) {
+			return SWEET_UAPI_ERR_BADARG;
+		}
+		for (i = 0; i < arg.op_count; i++) {
+			struct mali_uapi_bo *bo = mali_uapi_bo_by_handle(ops[i].handle);
+			uint64_t off = ops[i].offset, len = ops[i].size;
+
+			if (bo == NULL) {
+				return SWEET_UAPI_ERR_BADARG;
+			}
+			if (ops[i].type != MALI_UAPI_SYNC_CPU_CACHE_FLUSH &&
+			    ops[i].type != MALI_UAPI_SYNC_CPU_CACHE_FLUSH_INVALIDATE) {
+				return SWEET_UAPI_ERR_BADARG;
+			}
+			if (off >= (uint64_t)bo->size) {
+				return SWEET_UAPI_ERR_BADARG;
+			}
+			if (len == 0 || off + len > (uint64_t)bo->size) {
