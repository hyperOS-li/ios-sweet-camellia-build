+		bcopy(in, &arg, sizeof(arg));
+		return mali_uapi_bo_close(arg.handle);
+	}
+	case MALI_UAPI_SEL_SUBMIT: {
+		struct mali_uapi_submit arg;
+		uint32_t handles[SWEET_UAPI_HANDLES_MAX];
+		uint32_t in_syncs[SWEET_UAPI_HANDLES_MAX];
+		uint32_t i, seq;
+		int err;
+
+		bcopy(in, &arg, sizeof(arg));
+		if (arg.bo_handle_count > SWEET_UAPI_HANDLES_MAX ||
+		    (arg.bo_handle_count > 0 && arg.bo_handles == 0)) {
+			return SWEET_UAPI_ERR_BADARG;
+		}
+		if (arg.in_sync_count > SWEET_UAPI_HANDLES_MAX) {
+			return SWEET_UAPI_ERR_BADARG;
+		}
