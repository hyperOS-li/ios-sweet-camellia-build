+static bool
+trim_ok(const uint8_t *t)
+{
+	/* Novatek trim ids end in 0x03 and are not all zero/FF.  If this does
+	 * not look like a chip id the SPI mode is probably wrong. */
+	if (t[5] != 0x03) {
+		return false;
+	}
+	return !(t[0] == 0x00 && t[1] == 0x00 && t[2] == 0x00 &&
+	    t[3] == 0x00 && t[4] == 0x00);
+}
