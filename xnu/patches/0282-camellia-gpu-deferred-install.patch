+/* 0282: GPU power-on happens before mountroot, so the install runs from the
+ * 10 s status loop once vfs_rootvnode() exists. */
+static void
+sweet_install_harness(void)
+{
+	int err;
+
+		/* Userland GPU harness (arm64 iOS, ad-hoc signed). */
+		err = sweet_write_root_file("/usr/libexec/sweetuapi",
+		    sweet_uapi_bin, sizeof(sweet_uapi_bin), 0755);
+		sweet_inst_bin_write = err;
+		printf("SWEET INSTALL: sweetuapi %u bytes %s (err=%d)\n",
+		    (unsigned)sizeof(sweet_uapi_bin),
+		    err == 0 ? "written" : "FAILED", err);
+		if (err == 0) {
+			err = sweet_install_verify("/usr/libexec/sweetuapi",
+			    sweet_uapi_bin, sizeof(sweet_uapi_bin));
+			sweet_inst_bin_verify = err;
+			printf("SWEET INSTALL: sweetuapi readback %s (err=%d)\n",
+			    err == 0 ? "OK bytes identical" : "MISMATCH", err);
+		}
+		err = sweet_write_root_file(
+		    "/Library/LaunchDaemons/com.sweet.uapi.plist",
+		    sweet_uapi_plist, sizeof(sweet_uapi_plist), 0644);
+		sweet_inst_plist_write = err;
+		printf("SWEET INSTALL: launchd plist %u bytes %s (err=%d)\n",
+		    (unsigned)sizeof(sweet_uapi_plist),
+		    err == 0 ? "written" : "FAILED", err);
+		if (err == 0) {
+			err = sweet_install_verify(
+			    "/Library/LaunchDaemons/com.sweet.uapi.plist",
+			    sweet_uapi_plist, sizeof(sweet_uapi_plist));
+			sweet_inst_plist_verify = err;
+			printf("SWEET INSTALL: plist readback %s (err=%d)\n",
+			    err == 0 ? "OK bytes identical" : "MISMATCH", err);
+		}
+}
