 	    mali_prd(mali_p_gpu, 0x110), mali_prd(mali_p_gpu, 0x120));
+
+	/* 0282: install the userland harness once the root filesystem is up. */
+	if (!sweet_install_done) {
+		int enable = 0;
+
+		PE_parse_boot_argn("sweetinstall", &enable, sizeof(enable));
+		if (enable == 2 && vfs_rootvnode() != NULLVP) {
+			sweet_install_done = 1;
+			printf("SWEET INSTALL: deferred install start\n");
+			sweet_install_harness();
+		}
+	}
