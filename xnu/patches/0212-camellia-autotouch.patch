diff --git a/bsd/dev/sweet_autotouch.c b/bsd/dev/sweet_autotouch.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_autotouch.c
@@ -0,0 +1,120 @@
+/*
+ * Synthetic touch for camellia (M5 shortcut).
+ *
+ * Boot-arg sweetautotouch=1 starts a kernel thread after the UFS root is up.
+ * It presses volume-up once (a visible HID proof), then loops for a few
+ * minutes: swipe up from the home bar to unlock, and now and then tap one of
+ * several candidate Settings icon positions on the 1080x2400 panel.  It uses
+ * the existing HID injection entry points in iokit/Kernel/arm/hid/SweetHID.cpp
+ * so it does not need the (still missing) MT6833 touch hardware driver.
+ *
+ * The loop exists because SpringBoard comes up much later than this thread:
+ * a single swipe 20 s after boot (the first version) was far too early.
+ *
+ * Boot args:
+ *   sweetautotouch=1        enable (default 0)
+ *   sweetautotouchdelay=N   seconds before the first swipe (default 8)
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/kernel.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern void sweet_hid_key(int key, int down);
+
+static int sweet_autotouch_chan;
+static int sweet_autotouch_secs = 8;
+
+static void
+sweet_autotouch_sleep(int ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&sweet_autotouch_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* Swipe up from the home bar to dismiss the lock screen. */
+static void
+sweet_autotouch_swipe(void)
+{
+	printf("SWEET AUTOTOUCH: swipe\n");
+	sweet_hid_touch(0, 1, 540, 2300);
+	for (int y = 2240; y >= 1200; y -= 80) {
+		delay(12000);
+		sweet_hid_touch(0, 1, 540, y);
+	}
+	delay(12000);
+	sweet_hid_touch(0, 0, 540, 1200);
+}
+
+static void
+sweet_autotouch_tap(int x, int y)
+{
+	printf("SWEET AUTOTOUCH: tap %d,%d\n", x, y);
+	sweet_hid_touch(0, 1, x, y);
+	delay(80000);
+	sweet_hid_touch(0, 0, x, y);
+}
+
+static void
+sweet_autotouch_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int enable = 0;
+	/* Candidate Settings icon positions on the 1080x2400 home screen. */
+	static const int pts[][2] = {
+		{ 945, 550 }, { 675, 550 }, { 405, 550 }, { 945, 800 }, { 675, 800 },
+	};
+	const int npts = (int)(sizeof(pts) / sizeof(pts[0]));
+
+	(void)PE_parse_boot_argn("sweetautotouch", &enable, sizeof(enable));
+	if (enable == 0) {
+		return;
+	}
+	(void)PE_parse_boot_argn("sweetautotouchdelay", &sweet_autotouch_secs,
+	    sizeof(sweet_autotouch_secs));
+	if (sweet_autotouch_secs < 0 || sweet_autotouch_secs > 600) {
+		sweet_autotouch_secs = 8;
+	}
+	printf("SWEET AUTOTOUCH: start in %d s\n", sweet_autotouch_secs);
+	sweet_autotouch_sleep(sweet_autotouch_secs * 1000);
+
+	/* Volume up: a HUD on screen proves the HID path even if touch does not. */
+	sweet_hid_key(1, 1);
+	delay(60000);
+	sweet_hid_key(1, 0);
+
+	for (int i = 0; i < 30; i++) {
+		sweet_autotouch_swipe();
+		sweet_autotouch_sleep(2000);
+		if ((i % 3) == 0) {
+			sweet_autotouch_tap(pts[(i / 3) % npts][0], pts[(i / 3) % npts][1]);
+		}
+		sweet_autotouch_sleep(6000);
+	}
+	printf("SWEET AUTOTOUCH: done\n");
+
+	thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_autotouch_init(void)
+{
+	thread_t t;
+
+	if (kernel_thread_start(sweet_autotouch_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	} else {
+		printf("SWEET AUTOTOUCH: kernel_thread_start failed\n");
+	}
+}
