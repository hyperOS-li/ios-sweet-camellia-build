+/* IOConnectMapMemory64(memoryType = UAPI BO handle): the BO's descriptor, in
+ * the cacheable mode it was created with.  The same descriptor must come back
+ * on unmap, hence the table in sweet_gpu_shared_get(). */
+IOReturn
+SweetGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options,
+    IOMemoryDescriptor **memory)
+{
+	IOBufferMemoryDescriptor *md = sweet_gpu_shared_get((uint32_t)type);
+
+	if (md == NULL) {
+		return kIOReturnBadArgument;
+	}
+	md->retain();
+	*options = 0;
+	*memory = md;
+	return kIOReturnSuccess;
+}
