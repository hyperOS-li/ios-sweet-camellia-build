 extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern void sweet_touch_mtk_init(void);
 void sweet_touch_init(void);
 
 #define TOUCH_SE_PA      0x00a84000u
@@ -640,6 +641,16 @@
 {
 	int enabled = 1;
 	thread_t thread;
+	int mtk = 0;
+
+	/*
+	 * camellia (MT6833) has none of the Qualcomm GCC/TLMM/SE7 blocks this
+	 * driver uses; the MT6833 Novatek probe takes over when asked to.
+	 */
+	if (PE_parse_boot_argn("sweettouchmtk", &mtk, sizeof(mtk)) && mtk) {
+		sweet_touch_mtk_init();
+		return;
+	}
 	if (st.started) {
 		return;
 	}
